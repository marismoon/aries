{
  "name": "marismoon",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev --filter=@marismoon/demo",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui",
    "lint": "eslint .",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@marismoon/config": "workspace:*",
    "@eslint/js": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-jsx-a11y": "catalog:dev",
    "eslint-plugin-react-hooks": "catalog:dev",
    "eslint-plugin-react-refresh": "catalog:dev",
    "eslint-plugin-import-x": "catalog:dev",
    "eslint-import-resolver-typescript": "catalog:dev",
    "globals": "catalog:dev",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "catalog:dev",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "turbo": "^2"
  }
}
