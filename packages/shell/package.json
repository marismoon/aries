{
  "name": "@marismoon/shell",
  "version": "0.1.0-next.4",
  "description": "Aries 工作区外壳：三列布局、导航、页头与命令面板，路由与文案由宿主注入。",
  "keywords": [
    "react",
    "app-shell",
    "workspace",
    "layout",
    "navigation",
    "aries"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marismoon/aries.git",
    "directory": "packages/shell"
  },
  "homepage": "https://github.com/marismoon/aries/tree/main/packages/shell#readme",
  "bugs": {
    "url": "https://github.com/marismoon/aries/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/layout.css"
  },
  "scripts": {
    "build": "vite build -c vite.build.config.ts && tsc -p tsconfig.build.json && node ../../scripts/finalize-package.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@marismoon/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@marismoon/config": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:dev"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles": "./dist/styles/layout.css"
    }
  }
}
