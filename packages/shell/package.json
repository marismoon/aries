{
  "name": "@marismoon/shell",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/layout.css"
  },
  "sideEffects": [
    "./src/styles/*.css"
  ],
  "scripts": {
    "build": "vite build -c vite.build.config.ts && tsc -p tsconfig.build.json && node ../../scripts/finalize-package.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@marismoon/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@marismoon/config": "workspace:*",
    "@testing-library/react": "catalog:dev",
    "@types/react": "catalog:",
    "jsdom": "catalog:dev",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:dev"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles": "./dist/styles/layout.css"
    }
  }
}
