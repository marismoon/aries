{
  "name": "@marismoon/ui",
  "version": "0.1.0-next.1",
  "description": "Aries 设计系统：基于 shadcn 的 React 组件、Solar 图标、动效与九套品牌主题令牌（Tailwind CSS v4）。",
  "keywords": [
    "react",
    "design-system",
    "shadcn",
    "tailwindcss",
    "components",
    "aries"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marismoon/aries.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/marismoon/aries/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/marismoon/aries/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./ui/*": "./src/components/ui/*.tsx",
    "./shared/use-data-table": "./src/components/shared/use-data-table.ts",
    "./shared/*": "./src/components/shared/*.tsx",
    "./motion/motion-tokens": "./src/components/motion/motion-tokens.ts",
    "./motion/*": "./src/components/motion/*.tsx",
    "./icons": "./src/components/icons/index.ts",
    "./icons/*": "./src/components/icons/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "vite build -c vite.build.config.ts && tsc -p tsconfig.build.json && node ../../scripts/finalize-package.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm run build && node -e \"require('node:fs').copyFileSync('../../THIRD_PARTY_NOTICES.md','THIRD_PARTY_NOTICES.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('THIRD_PARTY_NOTICES.md',{force:true})\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "catalog:",
    "date-fns": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "catalog:",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react-day-picker": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@marismoon/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "shadcn": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:dev",
    "@types/node": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./ui/*": {
        "types": "./dist/components/ui/*.d.ts",
        "default": "./dist/components/ui/*.js"
      },
      "./shared/use-data-table": {
        "types": "./dist/components/shared/use-data-table.d.ts",
        "default": "./dist/components/shared/use-data-table.js"
      },
      "./shared/*": {
        "types": "./dist/components/shared/*.d.ts",
        "default": "./dist/components/shared/*.js"
      },
      "./motion/motion-tokens": {
        "types": "./dist/components/motion/motion-tokens.d.ts",
        "default": "./dist/components/motion/motion-tokens.js"
      },
      "./motion/*": {
        "types": "./dist/components/motion/*.d.ts",
        "default": "./dist/components/motion/*.js"
      },
      "./icons": {
        "types": "./dist/components/icons/index.d.ts",
        "default": "./dist/components/icons/index.js"
      },
      "./icons/*": {
        "types": "./dist/components/icons/*.d.ts",
        "default": "./dist/components/icons/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./styles/*": "./dist/styles/*"
    }
  }
}
